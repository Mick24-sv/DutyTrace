# Copy this file to .env and adjust. Never commit .env.
# Loaded automatically on startup by src/config/env.js.

NODE_ENV=development
PORT=4000

# Browser origin allowed to call this API (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Fallback timezone used for month boundaries in the existing monthly DTR workflow.
# Academic terms store their institution-specific timezone in the database.
APP_TIMEZONE=UTC

# --- Database (PostgreSQL) ---------------------------------------------
# Supabase: Project Settings -> Database -> connection string (Session pooler or Direct, port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@<host>:5432/postgres

# Separate database used ONLY by `npm test`. Tests wipe its tables, so it must
# never point at your dev or Supabase database.
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/dutytrace_test
TEST_DATABASE_SSL=false
# Optional CA file when the separate test database requires TLS.
TEST_DATABASE_SSL_CA=

# Supabase (hosted PostgreSQL): use the connection string from
# Project Settings -> Database, and turn SSL on:
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@<host>:5432/postgres
#   DATABASE_SSL=true
#   DATABASE_SSL_CA=/path/to/supabase-ca.crt   (optional, the CA from the Supabase dashboard)
# The database password is a SERVER-ONLY secret. Never put it in frontend/.
DATABASE_SSL=true

# --- Authentication ------------------------------------------------------
SESSION_HOURS=8             # login session lifetime
LOGIN_RATE_LIMIT_MAX=20     # login attempts per IP per 15 minutes
MAX_FAILED_LOGINS=5         # failed attempts before the account is temporarily locked
LOCKOUT_MINUTES=15
TRUST_PROXY=0               # set to 1 when deployed behind a reverse proxy

# --- QR attendance (Phase 3) ---------------------------------------------
# Signs office QR codes. Changing it invalidates every printed QR code.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional in development (a fixed dev value is used); REQUIRED in production.
# REQUIRED (32+ random characters):
QR_SIGNING_SECRET=
# Sessions longer than this are not counted as hours and are flagged for review.
MAX_SESSION_HOURS=12

# In-app academic deadline/missing-assignment reminder sweep interval (minutes, default 360).
REMINDER_INTERVAL_MINUTES=360

# --- Absence notices, cases and documents (Phase 5) ------------------------
# Where uploaded documents are stored. PRIVATE: never served as static files, keep it out of git
# and out of any web root. Default: backend/uploads/ (git-ignored). In production use a persistent,
# backed-up volume with restricted permissions.
UPLOAD_DIR=
MAX_UPLOAD_MB=5             # largest accepted file (PDF, PNG or JPEG only)
MAX_DOCS_PER_RECORD=10      # documents per absence notice or case

# --- Password Reset (email delivery) ----------------------------------------
# Leave all SMTP_* blank to use the development console fallback: the reset URL
# is printed to the backend server log and returned to the client (dev only).
# For Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=you@gmail.com  SMTP_PASS=<app-password>
# For Outlook / Hotmail:
#   SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DutyTrace <noreply@dutytrace.local>
# Public URL used in reset-link emails. Defaults to CLIENT_ORIGIN if not set.
APP_URL=http://localhost:5173
