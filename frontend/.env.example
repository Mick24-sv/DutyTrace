# Copy to .env if you need to override defaults. Never put secrets here:
# anything prefixed VITE_ is bundled into the browser code and is public.

# Where the Vite dev proxy forwards /api requests (the Express server).
VITE_API_PROXY_TARGET=http://localhost:4000

# Base URL for API calls. Keep "/api" in development (uses the proxy).
VITE_API_BASE_URL=/api
